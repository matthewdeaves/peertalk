# PeerTalk Retro68 Makefile for Classic Mac
# Usage: make -f Makefile.retro68 PLATFORM=mactcp
#    or: make -f Makefile.retro68 PLATFORM=mactcp test
#    or: make -f Makefile.retro68 unified   (MacTCP + AppleTalk)
#
# Produces:
#   build/mac/libpeertalk_mactcp.a      - MacTCP-only library (TCP/IP)
#   build/mac/libpeertalk_at.a          - AppleTalk-only library
#   build/mac/libpeertalk_mactcp_at.a   - Unified library (both transports)
#   build/mac/test_latency.bin          - Latency test (BinHex)
#   build/mac/test_throughput.bin       - Throughput test (BinHex)

RETRO68 ?= /opt/Retro68-build/toolchain

# Build output directory
BUILD_DIR = build/mac

# Select toolchain based on platform
ifeq ($(PLATFORM),mactcp)
    # 68k for MacTCP (System 6/7)
    PREFIX = $(RETRO68)/bin/m68k-apple-macos-
    REZ = $(RETRO68)/bin/Rez
    REZ_TEMPLATES = $(RETRO68)/RIncludes
    CFLAGS = -DPT_PLATFORM_MACTCP
    PLAT_DIR = mactcp
else ifeq ($(PLATFORM),ot)
    # PowerPC for Open Transport (can also target late 68k)
    PREFIX = $(RETRO68)/bin/powerpc-apple-macos-
    REZ = $(RETRO68)/bin/Rez
    MAKE_PEF = $(RETRO68)/bin/MakePEF
    REZ_TEMPLATES = $(RETRO68)/RIncludes
    CFLAGS = -DPT_PLATFORM_OT
    PLAT_DIR = opentransport
    # OT requires linking against OpenTransport shared libraries
    # App-level API (InitOpenTransport, OTOpenEndpoint, OTCloseProvider)
    OT_UNIV_DIR = $(RETRO68)/../universal/libppc
    # Core API (OTSnd, OTRcv, OTBind, OTListen, OTAtomic*, etc.)
    OT_MULTI_DIR = $(RETRO68)/../multiversal/libppc
    LDLIBS = -L$(OT_UNIV_DIR) -lOpenTransportAppPPC \
             -L$(OT_MULTI_DIR) -lOpenTransportLib -lOpenTptInternetLib
else
    $(error PLATFORM must be mactcp or ot)
endif

CC = $(PREFIX)gcc
AR = $(PREFIX)ar

CFLAGS += -Wall -Werror -O2 -I include -I src/core
CFLAGS += -DPT_LOG_ENABLED

# Core library sources
CORE_SRCS = \
    src/core/pt_version.c \
    src/core/pt_compat.c \
    src/core/pt_init.c \
    src/core/protocol.c \
    src/core/peer.c \
    src/core/peer_multi.c \
    src/core/queue.c \
    src/core/send.c \
    src/core/direct_buffer.c \
    src/core/stream.c \
    src/core/buffer_pool.c

# PT_Log sources (Mac version)
LOG_SRCS = src/log/pt_log_mac.c

# Platform-specific sources
ifeq ($(PLATFORM),mactcp)
PLAT_SRCS = \
    src/mactcp/platform_mactcp.c \
    src/mactcp/mactcp_driver.c \
    src/mactcp/udp_mactcp.c \
    src/mactcp/discovery_mactcp.c \
    src/mactcp/tcp_mactcp.c \
    src/mactcp/tcp_listen.c \
    src/mactcp/tcp_connect.c \
    src/mactcp/tcp_io.c \
    src/mactcp/poll_mactcp.c \
    src/mactcp/mactcp_multi.c
else ifeq ($(PLATFORM),ot)
PLAT_SRCS = \
    src/opentransport/platform_ot.c \
    src/opentransport/ot_driver.c \
    src/opentransport/udp_ot.c \
    src/opentransport/discovery_ot.c \
    src/opentransport/tcp_ot.c \
    src/opentransport/tcp_connect_ot.c \
    src/opentransport/tcp_server_ot.c \
    src/opentransport/poll_ot.c

# Additional OT AppleTalk sources (ADSP + NBP)
OT_AT_SRCS = \
    src/opentransport/ot_adsp.c \
    src/opentransport/ot_nbp.c
endif

# AppleTalk-specific sources (Phase 7 - stubs for now)
APPLETALK_SRCS = \
    src/appletalk/at_driver.c \
    src/appletalk/nbp_appletalk.c \
    src/appletalk/adsp_appletalk.c \
    src/appletalk/adsp_listen.c \
    src/appletalk/adsp_connect.c \
    src/appletalk/adsp_io.c \
    src/appletalk/poll_appletalk.c

# All library sources
LIB_SRCS = $(CORE_SRCS) $(LOG_SRCS) $(PLAT_SRCS)
LIB_OBJS = $(LIB_SRCS:%.c=$(BUILD_DIR)/%.o)

# Test applications are now individual performance tests (test_latency, etc.)

# Shared UI objects for test apps (must be defined before rules that use them)
STATUS_WINDOW_OBJ = $(BUILD_DIR)/tests/mac/status_window.o
TABLE_UI_OBJ = $(BUILD_DIR)/tests/mac/table_ui.o
TEST_UI_OBJS = $(STATUS_WINDOW_OBJ) $(TABLE_UI_OBJ)

# Performance test sources
PERF_TESTS = test_latency test_throughput test_stress test_discovery test_stream

# Output files
LIBNAME = $(BUILD_DIR)/libpeertalk_$(PLATFORM).a

# Targets
all: $(LIBNAME)

test: perf_tests

# Performance test targets
perf_tests: $(PERF_TESTS:%=$(BUILD_DIR)/%.bin)
	@echo "Performance tests built:"
	@ls -la $(BUILD_DIR)/*.bin 2>/dev/null || true

# Create build directories
$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/src/core:
	@mkdir -p $@

$(BUILD_DIR)/src/log:
	@mkdir -p $@

$(BUILD_DIR)/src/$(PLAT_DIR):
	@mkdir -p $@

$(BUILD_DIR)/tests/mac:
	@mkdir -p $@

# Object file compilation
$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Static library
$(LIBNAME): $(LIB_OBJS) | $(BUILD_DIR)
	$(AR) rcs $@ $^
	@echo "Built: $@"

# ============================================================================
# Performance Test Applications
# ============================================================================

# Build rules for shared UI objects
$(STATUS_WINDOW_OBJ): tests/mac/status_window.c tests/mac/status_window.h | $(BUILD_DIR)/tests/mac
	$(CC) $(CFLAGS) -c $< -o $@

$(TABLE_UI_OBJ): tests/mac/table_ui.c tests/mac/table_ui.h tests/mac/status_window.h | $(BUILD_DIR)/tests/mac
	$(CC) $(CFLAGS) -c $< -o $@

ifeq ($(PLATFORM),ot)
# ---- PPC build pipeline: .xcoff -> MakePEF -> .pef -> Rez with RetroPPCAPPL.r ----

# Link to XCOFF
$(BUILD_DIR)/test_%.xcoff: $(BUILD_DIR)/tests/mac/test_%.o $(TEST_UI_OBJS) $(LIBNAME)
	$(CC) $(CFLAGS) -o $@ $< $(TEST_UI_OBJS) -L$(BUILD_DIR) -lpeertalk_$(PLATFORM) $(LDLIBS)

# Convert XCOFF to PEF
$(BUILD_DIR)/test_%.pef: $(BUILD_DIR)/test_%.xcoff
	$(MAKE_PEF) $< -o $@

# Rez PEF into final application
$(BUILD_DIR)/test_%.bin: $(BUILD_DIR)/test_%.pef
	@if [ -f tests/mac/test_$*.r ]; then \
		$(REZ) $(REZ_TEMPLATES)/RetroPPCAPPL.r tests/mac/test_$*.r \
			-DCFRAG_NAME="\"test_$*\"" \
			--data $< \
			-o $@ \
			-t "APPL" -c "PTTK" \
			--cc $(BUILD_DIR)/test_$*.dsk; \
		echo "Built: $@ (PPC, custom resources)"; \
	else \
		$(REZ) $(REZ_TEMPLATES)/RetroPPCAPPL.r tests/mac/PeerTalkTest.r \
			-DCFRAG_NAME="\"test_$*\"" \
			--data $< \
			-o $@ \
			-t "APPL" -c "PTTK" \
			--cc $(BUILD_DIR)/test_$*.dsk; \
		echo "Built: $@ (PPC, shared PeerTalkTest.r)"; \
	fi

else
# ---- 68k build pipeline: .code.bin -> Rez with Retro68APPL.r ----

# Link to CODE binary
$(BUILD_DIR)/test_%.code.bin: $(BUILD_DIR)/tests/mac/test_%.o $(TEST_UI_OBJS) $(LIBNAME)
	$(CC) $(CFLAGS) -o $@ $< $(TEST_UI_OBJS) -L$(BUILD_DIR) -lpeertalk_$(PLATFORM) $(LDLIBS)

# Rez CODE into final application
$(BUILD_DIR)/test_%.bin: $(BUILD_DIR)/test_%.code.bin
	@if [ -f tests/mac/test_$*.r ]; then \
		$(REZ) $(REZ_TEMPLATES)/Retro68APPL.r tests/mac/test_$*.r \
			--copy $< \
			-o $@ \
			-t "APPL" -c "PTTK" \
			--cc $(BUILD_DIR)/test_$*.dsk; \
		echo "Built: $@ (68k, custom resources)"; \
	else \
		$(REZ) $(REZ_TEMPLATES)/Retro68APPL.r tests/mac/PeerTalkTest.r \
			--copy $< \
			-o $@ \
			-t "APPL" -c "PTTK" \
			--cc $(BUILD_DIR)/test_$*.dsk; \
		echo "Built: $@ (68k, shared PeerTalkTest.r)"; \
	fi
endif

# Individual performance test targets
test_latency: $(BUILD_DIR)/test_latency.bin
	@echo "Latency test built: $<"

test_throughput: $(BUILD_DIR)/test_throughput.bin
	@echo "Throughput test built: $<"

test_stress: $(BUILD_DIR)/test_stress.bin
	@echo "Stress test built: $<"

test_discovery: $(BUILD_DIR)/test_discovery.bin
	@echo "Discovery test built: $<"

test_stream: $(BUILD_DIR)/test_stream.bin
	@echo "Stream test built: $<"

.PHONY: test_latency test_throughput test_stress test_discovery test_stream perf_tests

# ============================================================================
# Low-Memory Performance Tests (for 4MB Macs like SE, Plus, Classic)
# ============================================================================

LOWMEM_TESTS = test_latency_lowmem test_throughput_lowmem test_stream_lowmem test_stress_lowmem test_discovery_lowmem

lowmem_tests: $(LOWMEM_TESTS:%=$(BUILD_DIR)/%.bin)
	@echo "Low-memory tests built (512KB-768KB heap):"
	@ls -la $(BUILD_DIR)/*_lowmem.bin 2>/dev/null || true

# Low-memory test binaries use same code but different SIZE resource
$(BUILD_DIR)/test_%_lowmem.bin: $(BUILD_DIR)/test_%.code.bin tests/mac/PeerTalkTest_LowMem.r
	$(REZ) $(REZ_TEMPLATES)/Retro68APPL.r tests/mac/PeerTalkTest_LowMem.r \
		--copy $< \
		-o $@ \
		-t "APPL" -c "PTTK" \
		--cc $(BUILD_DIR)/test_$*_lowmem.dsk
	@echo "Built: $@ (for 4MB Macs) - 512KB-768KB heap"

.PHONY: lowmem_tests

# Clean
clean:
	rm -rf $(BUILD_DIR)
	find src -name "*.o" -delete
	find tests -name "*.o" -delete

# ============================================================================
# Unified Library Builds (MacTCP + AppleTalk)
# ============================================================================

# Multi-transport compilation flags
CFLAGS_UNIFIED = -DPT_MULTI_TRANSPORT=1

# Unified library object files (need _unified suffix to avoid conflicts)
MACTCP_UNIFIED_OBJS = $(PLAT_SRCS:src/mactcp/%.c=$(BUILD_DIR)/src/mactcp/%_unified.o)
APPLETALK_UNIFIED_OBJS = $(APPLETALK_SRCS:src/appletalk/%.c=$(BUILD_DIR)/src/appletalk/%_unified.o)
CORE_UNIFIED_OBJS = $(CORE_SRCS:%.c=$(BUILD_DIR)/%_unified.o)
LOG_UNIFIED_OBJS = $(LOG_SRCS:%.c=$(BUILD_DIR)/%_unified.o)

# Unified library target
LIB_MACTCP_AT = $(BUILD_DIR)/libpeertalk_mactcp_at.a
LIB_AT_ONLY = $(BUILD_DIR)/libpeertalk_at.a

# Build unified library (MacTCP + AppleTalk)
# Note: Requires Phase 7 AppleTalk sources to be implemented
unified: $(LIB_MACTCP_AT)
	@echo "Built: $(LIB_MACTCP_AT)"
	@echo "Note: Link this library to get both TCP/IP and AppleTalk support"

# Unified object file compilation (with PT_MULTI_TRANSPORT=1)
$(BUILD_DIR)/%_unified.o: %.c | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CFLAGS_UNIFIED) -c $< -o $@

# AppleTalk-only object file compilation
$(BUILD_DIR)/src/appletalk/%.o: src/appletalk/%.c | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DPT_PLATFORM_APPLETALK -c $< -o $@

# Unified library (MacTCP + AppleTalk)
$(LIB_MACTCP_AT): $(CORE_UNIFIED_OBJS) $(LOG_UNIFIED_OBJS) $(MACTCP_UNIFIED_OBJS) $(APPLETALK_UNIFIED_OBJS)
	$(AR) rcs $@ $^
	@echo "Unified library: $@"

# AppleTalk-only library
$(LIB_AT_ONLY): $(CORE_SRCS:%.c=$(BUILD_DIR)/%.o) $(LOG_SRCS:%.c=$(BUILD_DIR)/%.o) $(APPLETALK_SRCS:src/appletalk/%.c=$(BUILD_DIR)/src/appletalk/%.o)
	$(AR) rcs $@ $^
	@echo "AppleTalk library: $@"

# ============================================================================
# OT + AppleTalk Unified Library (Open Transport TCP/IP + ADSP/NBP)
# ============================================================================

# OT + AT source list (TCP/IP core + ADSP + NBP)
OT_AT_ALL_SRCS = $(CORE_SRCS) $(LOG_SRCS) \
    src/opentransport/platform_ot.c \
    src/opentransport/ot_driver.c \
    src/opentransport/udp_ot.c \
    src/opentransport/discovery_ot.c \
    src/opentransport/tcp_ot.c \
    src/opentransport/tcp_connect_ot.c \
    src/opentransport/tcp_server_ot.c \
    src/opentransport/poll_ot.c \
    src/opentransport/ot_adsp.c \
    src/opentransport/ot_nbp.c

OT_AT_OBJS = $(OT_AT_ALL_SRCS:%.c=$(BUILD_DIR)/%_ot_at.o)

LIB_OT_AT = $(BUILD_DIR)/libpeertalk_ot_at.a

# Build OT+AT unified library
ot_at: $(LIB_OT_AT)
	@echo "Built: $(LIB_OT_AT)"
	@echo "Note: Link this library for OT TCP/IP + AppleTalk (ADSP/NBP)"

# OT+AT object compilation (uses CFLAGS which already includes platform flag)
$(BUILD_DIR)/%_ot_at.o: %.c | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(LIB_OT_AT): $(OT_AT_OBJS)
	$(AR) rcs $@ $^
	@echo "OT+AT unified library: $@"

.PHONY: ot_at

# ============================================================================
# Info and Help
# ============================================================================

# Show what would be built
info:
	@echo "Platform: $(PLATFORM)"
	@echo "Toolchain: $(PREFIX)"
	@echo "Rez: $(REZ)"
	@echo "Library sources: $(LIB_SRCS)"
	@echo "Output library: $(LIBNAME)"
	@echo "Performance tests: $(PERF_TESTS)"

help:
	@echo "PeerTalk Retro68 Build System"
	@echo ""
	@echo "Usage:"
	@echo "  make -f Makefile.retro68 PLATFORM=mactcp             Build MacTCP library"
	@echo "  make -f Makefile.retro68 PLATFORM=mactcp test        Build all test apps"
	@echo "  make -f Makefile.retro68 PLATFORM=mactcp perf_tests  Build perf test apps"
	@echo "  make -f Makefile.retro68 PLATFORM=mactcp unified     Build unified library"
	@echo ""
	@echo "Libraries:"
	@echo "  libpeertalk_mactcp.a      MacTCP-only (TCP/IP)"
	@echo "  libpeertalk_at.a          AppleTalk-only"
	@echo "  libpeertalk_mactcp_at.a   Unified (both transports)"
	@echo ""
	@echo "Test Applications:"
	@echo "  test_latency.bin          RTT measurement test"
	@echo "  test_throughput.bin       Throughput test"
	@echo "  test_stress.bin           Connect/disconnect stress test"
	@echo "  test_discovery.bin        Discovery stability test"
	@echo "  test_stream.bin           Unidirectional streaming test"

.PHONY: all test clean info help unified
